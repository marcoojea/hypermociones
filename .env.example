# PostgreSQL connection used by future database-backed repositories and migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hypermociones

# Proveedor gratuito recomendado. No requiere cuenta ni clave privada.
DATA_PROVIDER=free-public
FOOTBALL_SEASON=2026
# Pausa respetuosa entre lecturas de las fichas oficiales.
FOOTBALL_REQUEST_INTERVAL_MS=500

# Alternativa API-Football (la temporada actual requiere un plan de pago).
API_FOOTBALL_API_KEY=

# Alternative paid provider: football-data.org (Segunda División requires sufficient tier).
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_COMPETITION=SD
FOOTBALL_DATA_SEASON=2026
# Aggregates require one extra request per player; enable only with a suitable quota.
FOOTBALL_DATA_INCLUDE_PLAYER_AGGREGATES=false
# Free accounts document 10 requests/minute. Lower only if your contracted plan permits it.
FOOTBALL_DATA_REQUEST_INTERVAL_MS=6500
